{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32F103C8 - OpenOCD",
            "type": "stgdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "program": "${workspaceFolder}/build/Debug/EDCstm32.elf",
            "gdb": "${command:st-stm32-ide-debug-launch.get-gdb-executable}",
            "deviceName": "STM32F103C8",
            "deviceCore": "Cortex-M3",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/EDCstm32.elf"
                }
            ],
            "serverExe": "openocd.exe",
            "serverParameters": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f1x.cfg",
                "-c",
                "adapter speed 1000"
            ],
            "serverCwd": "C:/Users/sakuya/AppData/Local/Microsoft/WinGet/Packages/xpack-dev-tools.openocd-xpack_Microsoft.Winget.Source_8wekyb3d8bbwe/xpack-openocd-0.12.0-7/bin",
            "serverHost": "localhost",
            "serverPort": "3333",
            "verbose": true,
            "logFile": "${workspaceFolder}/gdbClient_log.txt"
        }
    ]
}
